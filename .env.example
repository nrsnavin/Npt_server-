NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/npt_erp
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Bare local phone numbers are normalised with this country code
DEFAULT_COUNTRY_CODE=+91

# One-time passcodes
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Development only: returns the code in the API response when no provider is configured
OTP_EXPOSE_IN_RESPONSE=true

# Email delivery (optional in development — codes are logged to the console instead)
# Leave SMTP_HOST empty to print codes to the console instead — that is a supported way to
# run in development, not a broken one.
#
# Fill it in and the server checks the block at startup rather than on the first sign-in: a
# host with a user but no password is refused by name, because nodemailer's own error for
# that case ("Missing credentials for PLAIN") names neither the variable nor the fix.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER is the full address, and
# SMTP_PASSWORD is a 16-character App Password from the Google account's security settings —
# the account password does not work and 2-Step Verification must be on first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NPT Hangers <no-reply@npthangers.com>

# SMS delivery via Twilio (optional in development — codes are logged to the console instead;
# required in production, where the server refuses to start without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set one of the two. A messaging service is preferred in production: it handles the
# number pool, sender selection and local compliance for you.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# How long to wait on Twilio, and how many total attempts on a transient failure
TWILIO_TIMEOUT_MS=10000
TWILIO_MAX_ATTEMPTS=2

# --- WhatsApp (Twilio) -------------------------------------------------------
# A WhatsApp-enabled sender. The sandbox number works for testing:
#   TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Approved template content SIDs, one per notification.
#
# Meta only allows free text within 24 hours of the customer's own last message. Anything
# business-initiated outside that window — which is what a sample update is — must be a
# template approved in advance, or WhatsApp refuses it with error 63016. Register the two
# below in the Twilio Content Template Builder and put their SIDs here.
#
# Variables for SAMPLE_READY, in order: 1 customer name, 2 sample number, 3 model,
# 4 colour, 5 quantity, 6 a sentence about the courier — either how it is being sent, when
# that has been arranged already, or that we will confirm shortly. It is one variable rather
# than an optional line because an approved template has a fixed shape.
#
# Variables for SAMPLE_DISPATCHED: 1 customer name, 2 sample number, 3 model, 4 colour,
# 5 quantity sent, 6 courier, 7 AWB number.
WHATSAPP_TEMPLATE_SAMPLE_READY=
WHATSAPP_TEMPLATE_SAMPLE_DISPATCHED=
