NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/npt_erp
# On a replica set (Atlas, or one node — docs/SCALING.md §1) multi-record writes run as
# transactions. MONGO_TRANSACTIONS=off turns them off without touching the database.
# MONGO_TRANSACTIONS=off
# Connections per process; the database sees this × the number of API/worker processes.
# MONGO_MAX_POOL_SIZE=50

# --- Scaling out (all optional; docs/SCALING.md) ---------------------------------
# Redis: shared rate limits, the signed-in user cache and the AI caches. Unset, all of it stays
# in each process as before. ElastiCache with TLS: rediss://...
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=npt:
# CACHE_TIMEOUT_MS=200
# Uploads in S3 instead of on this machine's disk. Credentials: the instance's IAM role, else
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. Copy the old folder: npm run migrate:uploads-to-s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_PREFIX=uploads/
# Where files go without S3 (default: uploads/ beside src/).
# UPLOAD_DIR=
# With a separate worker (npm run worker) running the reminders and sweeps, set this on the API.
# Safe either way: each job runs on one process at a time.
# RUN_BACKGROUND=false
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Where the web app lives, for links in emails (welcome, password reset, query tags).
# Defaults to the first CORS_ORIGIN. Production: https://npt.baluelastics.com
APP_URL=

# Bare local phone numbers are normalised with this country code
DEFAULT_COUNTRY_CODE=+91

# One-time passcodes
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Development only: returns the code in the API response when no provider is configured
OTP_EXPOSE_IN_RESPONSE=true

# Email delivery (optional in development — codes are logged to the console instead)
# Leave SMTP_HOST empty to print codes to the console instead — that is a supported way to
# run in development, not a broken one.
#
# Fill it in and the server checks the block at startup rather than on the first sign-in: a
# host with a user but no password is refused by name, because nodemailer's own error for
# that case ("Missing credentials for PLAIN") names neither the variable nor the fix.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER is the full address, and
# SMTP_PASSWORD is a 16-character App Password from the Google account's security settings —
# the account password does not work and 2-Step Verification must be on first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # SMTP_PASS also works — nodemailer's own name for it
SMTP_FROM=NPT Hangers <no-reply@npthangers.com>

# SMS delivery via Twilio. Optional: without it, phone sign-in codes go by WhatsApp when
# WHATSAPP_TEMPLATE_OTP is set (see the WhatsApp section). Production needs one of the two.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set one of the two. A messaging service is preferred in production: it handles the
# number pool, sender selection and local compliance for you.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# How long to wait on Twilio, and how many total attempts on a transient failure
TWILIO_TIMEOUT_MS=10000
TWILIO_MAX_ATTEMPTS=2

# --- WhatsApp ---------------------------------------------------------------
# Either Meta's WhatsApp Business Platform (the Cloud API — recommended, no middleman) or Twilio.
# Meta is used when its settings are set; WHATSAPP_PROVIDER=meta|twilio forces one.
# WHATSAPP_PROVIDER=

# Meta WhatsApp Business Platform. From Meta Business Manager and developers.facebook.com:
#   META_WA_TOKEN            a permanent System User token with whatsapp_business_messaging
#                            (Business settings → Users → System users → Generate token)
#   META_WA_PHONE_NUMBER_ID  WhatsApp → API Setup → "Phone number ID" (an id, not the number)
#   META_WA_APP_SECRET       App settings → Basic → App secret; proves a webhook came from Meta
#   META_WA_VERIFY_TOKEN     any long random string; typed in once when setting up the webhook
# Webhook: WhatsApp → Configuration → Callback URL https://<api host>/api/whatsapp/inbound,
# Verify token = META_WA_VERIFY_TOKEN, then subscribe to the "messages" field.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
# Template language when a template name does not give one (name:language), and API version.
# META_WA_TEMPLATE_LANGUAGE=en
# META_WA_API_VERSION=v23.0

# Twilio, instead of Meta. A WhatsApp-enabled sender; the sandbox works for testing:
#   TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Approved templates. WhatsApp accepts free text only within 24 hours of the person's own last
# message; anything else must be a template approved in advance. On Meta, give the template's
# name (optionally name:language, e.g. quotation_sent:en_US), created in WhatsApp Manager →
# Message templates. On Twilio, give its content SID (HX…). Empty sends plain text, which works
# only inside the 24-hour window. Placeholders must be in this order:
#
#   QUOTE              {{1}} buyer's name, {{2}} quote number, {{3}} link to the PDF
#   TAG                {{1}} who tagged them, {{2}} the query number, {{3}} the link
#   SAMPLE_READY       {{1}} customer, {{2}} sample number, {{3}} model, {{4}} colour,
#                      {{5}} quantity, {{6}} a sentence about the courier
#   SAMPLE_DISPATCHED  {{1}} customer, {{2}} sample number, {{3}} model, {{4}} colour,
#                      {{5}} quantity sent, {{6}} courier, {{7}} AWB number
#   OTP                an Authentication template with a copy-code button: sign-in codes for
#                      phone numbers go by WhatsApp when Twilio SMS is not set
WHATSAPP_TEMPLATE_QUOTE=
WHATSAPP_TEMPLATE_TAG=
WHATSAPP_TEMPLATE_SAMPLE_READY=
WHATSAPP_TEMPLATE_SAMPLE_DISPATCHED=
WHATSAPP_TEMPLATE_OTP=

# The API's public address, with /api — WhatsApp downloads a quotation's PDF from a signed link
# on it, so it must be reachable from the internet over https. Unset, it is taken from the
# request, which is right behind a correctly configured proxy.
# PUBLIC_API_URL=https://api.example.com/api

# The inbound front door [§41] for Twilio. Posts to /api/whatsapp/inbound have no session
# behind them — Meta's are checked by META_WA_APP_SECRET's signature; Twilio's by this token,
# so make it long and random, and set it as an `x-webhook-token` header (or ?token=) on the
# webhook. Unset, a Twilio post is answered 503 rather than accepted.
WHATSAPP_WEBHOOK_TOKEN=

# How often the sampling escalation sweeps, in minutes. 0 turns it off.
ESCALATION_INTERVAL_MINUTES=60

# Ask Jarvis — reading the question with a language model (optional)
# Leave ANTHROPIC_API_KEY empty and the assistant still works: it falls back to the rules
# parser in services/jarvis.intents.js, which answers the common questions well. That is a
# supported way to run, not a broken one — the key buys better handling of the phrasings the
# rules do not have a keyword for ("anything slipping?"), and nothing else.
#
# The model never sees a record and never produces a figure. It turns the sentence into a
# subject and an aspect from a fixed list; every number in every answer comes from a query run
# under the asker's own grants. That split is why a misparse can at worst answer a different
# question, and why an injected instruction cannot widen anybody's access.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. Claude Haiku 4.5 (claude-haiku-4-5) is a fraction of the cost and
# noticeably faster on a classification this small, which is what this is — worth trying if
# the panel feels slow or the bill matters more than the last few unusual phrasings.
JARVIS_MODEL=

# Samples nobody is working on [the anomaly sweep]
# A sample untouched for this many WORKING days is an anomaly, and management is told. The
# sweep runs on the same timer as the escalation (ESCALATION_INTERVAL_MINUTES).
ANOMALY_STALL_DAYS=1
# The plant's weekly off, 0=Sunday … 6=Saturday. Counted out of the idle days, because with
# calendar days every open sample is an anomaly every Monday morning — and a list that flags
# everything is a list nobody reads.
ANOMALY_WEEKLY_OFF=0

# IndiaMART lead auto-load [§41 by analogy]
#
# Leave INDIAMART_CRM_KEY empty and the feed is off entirely — no polling, no warnings. That is
# the right state for a deployment that does not sell through IndiaMART.
#
# The key comes from Lead Manager → Import/Export Leads → API. It is the whole integration:
# anyone holding it can read every enquiry your listing has ever received, so treat it like a
# password and never commit it.
INDIAMART_CRM_KEY=
# Their endpoint. Overridable because it has moved between versions before, and a deployment
# should not need a code change to follow it.
INDIAMART_API_URL=https://mapi.indiamart.com/wservce/crm/crmListing/v2/
# How often to pull. IndiaMART rate-limits this endpoint to roughly one call every five minutes
# and answers a burst with an error instead of data — so polling harder returns fewer leads, not
# more. Nothing is missed by waiting: the watermark means a slow poll is only ever late.
INDIAMART_POLL_MINUTES=15
# How far back the very first run reaches, before there is a watermark. Their window is capped
# at seven days; asking for more returns nothing rather than more.
INDIAMART_BACKFILL_DAYS=7
# Overlap re-asked on every poll. Their timestamps are the buyer's clock, not ours, and a lead
# landing either side of the watermark would fall between two windows. Re-reading is free —
# ingestion is idempotent on their query id — so the overlap costs nothing and closes the gap.
INDIAMART_OVERLAP_MINUTES=10
INDIAMART_TIMEOUT_MS=20000

# Chirix ERP sales order import [§12]
#
# Leave CHIRIX_API_KEY empty and the feed is off entirely — no polling, no warnings. That is the
# right state for a deployment that does not run Chirix, and the right state for every deployment
# until the vendor has answered the questions in docs/CHIRIX_API_REQUEST.md.
#
# Read-only, one-directional: orders raised in Chirix appear here, and nothing is ever written
# back. Ask them for a read-only credential — one that can write is a standing risk with no
# upside. Treat the key like a password and never commit it.
CHIRIX_API_KEY=
# Their base URL for listing sales orders, including the version segment. No trailing slash.
CHIRIX_API_URL=
# How the key is presented. Most vendors take `Authorization: Bearer <key>`, which is the default.
# A vendor using a bare key sets CHIRIX_AUTH_SCHEME to nothing; one using their own header name
# sets CHIRIX_AUTH_HEADER, e.g. X-API-Key.
CHIRIX_AUTH_HEADER=Authorization
CHIRIX_AUTH_SCHEME=Bearer
# How often to pull. Slower than it could be on purpose: nothing downstream of a sales order
# happens in under an hour, and the §13 checks take longer than that, so polling harder spends
# their rate limit to buy nothing.
CHIRIX_POLL_MINUTES=15
# How far back the very first run reaches, before there is a watermark.
CHIRIX_BACKFILL_DAYS=7
# Overlap re-asked on every poll. Their modifiedSince is their clock, not ours, and an order
# landing either side of the watermark would fall between two windows. Re-reading is free — the
# import is idempotent on (source, id) — so the overlap costs a few rows and closes the gap.
CHIRIX_OVERLAP_MINUTES=30
CHIRIX_TIMEOUT_MS=20000
# Who an imported order belongs to when the salesperson is unmapped and the buyer is new [§29].
# An email rather than an id: a .env written by a person should not contain an ObjectId, and the
# email survives a re-seed.
CHIRIX_FALLBACK_OWNER_EMAIL=

# Push notifications to the installed app (phones and browsers). Generate a pair once with
#   npx web-push generate-vapid-keys
# Leave empty and nothing is pushed — the message is printed to the console instead.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:info@example.com

# Leads from photos: staff send a visiting card to the WhatsApp number, the model reads it,
# and it becomes a lead when they reply YES (or confirm it on Leads → Cards to confirm).
# Needs ANTHROPIC_API_KEY; without it the photo still arrives and is typed in by hand.
# LEAD_CARD_MODEL=claude-sonnet-5
# On Twilio, where WhatsApp photos may be downloaded from. Leave as Twilio's API.
# (On Meta, photos come by id from Meta's own servers; nothing to set.)
# WHATSAPP_MEDIA_HOSTS=api.twilio.com
