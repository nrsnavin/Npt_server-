{
  "name": "npt-server",
  "version": "1.0.0",
  "private": true,
  "description": "NPT CRM + ERP API \u2014 CRM, manufacturing, inventory and accounts for a hanger manufacturing business",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "seed": "node src/seed/index.js",
    "test": "node --test tests/*.test.js",
    "test:replset": "node --import ./tests/support/replset.mjs --test tests/*.test.js",
    "create-user": "node scripts/create-user.js",
    "set-quote-number": "node scripts/set-quote-number.js",
    "load-test": "node tests/load/load-test.mjs",
    "volume-test": "node tests/load/volume-test.mjs",
    "doctor:indexes": "node scripts/doctor-indexes.js",
    "reset-data": "node scripts/reset-data.js",
    "migrate:quotation-lines": "node scripts/migrate-quotation-lines.js",
    "migrate:pricing-lines": "node scripts/migrate-pricing-lines.js",
    "migrate:query-reads": "node scripts/migrate-query-reads.js",
    "migrate:moulds": "node scripts/migrate-catalogue-to-moulds.js",
    "migrate:grants": "node scripts/migrate-module-grants.js",
    "migrate:task-departments": "node scripts/migrate-task-departments.js",
    "migrate:grant-modules": "node scripts/grant-new-modules.js",
    "backfill:addresses": "node scripts/backfill-delivery-addresses.js",
    "backfill:enquiry-items": "node scripts/backfill-enquiry-items.js",
    "doctor:consistency": "node scripts/doctor-consistency.js",
    "doctor:workflows": "node scripts/doctor-workflows.js",
    "migrate:uploads-to-s3": "node scripts/migrate-uploads-to-s3.js",
    "delete:leads": "node scripts/delete-leads.js",
    "migrate:enquiry-stages": "node scripts/migrate-enquiry-stages.js",
    "migrate:enquiry-holders": "node scripts/migrate-enquiry-holders.js",
    "migrate:merge-costing": "node scripts/migrate-merge-costing.js",
    "migrate:confirm-receipts": "node scripts/migrate-confirm-receipts.js",
    "migrate:all": "node scripts/migrate-all.js",
    "seed:demo": "node src/seed/index.js --keep-users --full",
    "seed:volume": "node src/seed/volume.js",
    "import:mould-sheet": "node scripts/import-mould-sheet.js",
    "register-team": "node scripts/register-team.js",
    "import:materials": "node scripts/import-materials.js",
    "import:aux": "node scripts/import-aux.js",
    "import:customers": "node scripts/import-customers.js",
    "realign-enquiries": "node scripts/realign-enquiries.js",
    "reopen:lr-closed": "node scripts/reopen-lr-closed.js",
    "reset:fresh-start": "node scripts/reset-data.js --keep=rsnavin1@gmail.com,info@navinplastic.com --keep-customers --keep-masters",
    "workflow-load-test": "node tests/load/workflow-load.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' tests/*.test.js",
    "load-test:50": "node tests/load/workflow-load.mjs --users=50 --think=2000 --instances=2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.1",
    "redis": "^5.12.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4"
  }
}
